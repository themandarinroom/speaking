rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validYearLevel(yearLevelId) {
      return yearLevelId in ['prep', 'year-1', 'year-2', 'year-3', 'year-4', 'year-5', 'year-6'];
    }

    function isAuthorisedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.active == true;
    }

    function validTeacherAudio(audio, expectedPath) {
      return audio is map
        && audio.keys().hasOnly(['path', 'downloadURL', 'contentType', 'revision'])
        && audio.path == expectedPath
        && audio.downloadURL is string
        && audio.contentType is string
        && audio.contentType.matches('audio/.*')
        && audio.revision is int;
    }

    function validPractice(practice, yearLevelId, practiceId) {
      return practice is map
        && practice.keys().hasOnly(['label', 'words', 'teacherAudio', 'substitution'])
        && practice.label is string
        && practice.label.size() <= 60
        && practice.words is list
        && practice.words.size() > 0
        && practice.words.size() <= 50
        && (!practice.keys().hasAny(['substitution'])
          || (practice.substitution is map
            && practice.substitution.keys().hasOnly(['enabled', 'targetWordId', 'vocabulary', 'keyVocabSource', 'vocabularySetId'])
            && practice.substitution.enabled == true
            && practice.substitution.targetWordId is string
            && practice.substitution.targetWordId.size() > 0
            && ((!practice.substitution.keys().hasAny(['keyVocabSource']) || practice.substitution.keyVocabSource == 'manual')
              && practice.substitution.vocabulary is list
              && practice.substitution.vocabulary.size() > 0
              && practice.substitution.vocabulary.size() <= 20
              || practice.substitution.keyVocabSource == 'vocabulary-library'
                && practice.substitution.vocabularySetId is string
                && practice.substitution.vocabularySetId.matches('[a-z0-9]+(-[a-z0-9]+)*'))))
        && (!practice.keys().hasAny(['teacherAudio'])
          || validTeacherAudio(practice.teacherAudio, 'teacher-recordings/' + yearLevelId + '/' + practiceId + '/latest'));
    }

    function validYearLevelDocument(yearLevelId) {
      return request.resource.data.keys().hasOnly([
          'yearLevelId', 'yearLevelLabel', 'lessonTitle', 'practices',
          'displaySettings', 'audioSettings', 'published', 'updatedAt'
        ])
        && request.resource.data.yearLevelId == yearLevelId
        && request.resource.data.yearLevelLabel is string
        && request.resource.data.lessonTitle is string
        && request.resource.data.lessonTitle.size() <= 80
        && request.resource.data.practices is map
        && request.resource.data.practices.keys().hasOnly(['core', 'challenge'])
        && request.resource.data.practices.keys().hasAll(['core', 'challenge'])
        && validPractice(request.resource.data.practices.core, yearLevelId, 'core')
        && validPractice(request.resource.data.practices.challenge, yearLevelId, 'challenge')
        && request.resource.data.displaySettings is map
        && request.resource.data.audioSettings is map
        && request.resource.data.published == true
        && request.resource.data.updatedAt == request.time;
    }

    match /yearLevels/{yearLevelId} {
      allow get: if isAuthorisedTeacher() || (validYearLevel(yearLevelId) && resource.data.published == true);
      allow list: if false;
      allow create, update: if validYearLevel(yearLevelId) && isAuthorisedTeacher() && validYearLevelDocument(yearLevelId);
      allow delete: if false;
    }

    match /authorizedTeachers/{teacherId} {
      allow get: if request.auth != null && request.auth.uid == teacherId;
      allow list, create, update, delete: if false;
    }

    match /vocabularySets/{setId} {
      allow get, list: if resource.data.published == true;
      allow write: if false;
    }

    match /vocabularyTeacherVoices/{voiceId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
