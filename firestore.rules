rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validRoom(roomId) {
      return roomId in ['6B', '6D', '5C', '5E', '4B', '4C', '4D', '3A', '3B'];
    }

    function isAuthorisedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.active == true;
    }

    function validRoomDocument(roomId) {
      return request.resource.data.keys().hasOnly([
          'roomId', 'title', 'words', 'displaySettings', 'audioSettings',
          'published', 'updatedAt'
        ])
        && request.resource.data.roomId == roomId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.words is list
        && request.resource.data.words.size() > 0
        && request.resource.data.words.size() <= 50
        && request.resource.data.displaySettings is map
        && request.resource.data.audioSettings is map
        && request.resource.data.published == true
        && request.resource.data.updatedAt == request.time;
    }

    match /rooms/{roomId} {
      allow get: if isAuthorisedTeacher()
        || (validRoom(roomId) && resource.data.published == true);
      allow list: if false;
      allow create, update: if validRoom(roomId)
        && isAuthorisedTeacher()
        && validRoomDocument(roomId);
      allow delete: if false;
    }

    match /authorizedTeachers/{teacherId} {
      allow get: if request.auth != null && request.auth.uid == teacherId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
