rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function validYearLevel(yearLevelId) {
      return yearLevelId in ['prep', 'year-1', 'year-2', 'year-3', 'year-4', 'year-5', 'year-6'];
    }

    function validPractice(practiceId) {
      return practiceId in ['core', 'challenge'];
    }

    function isAuthorisedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/authorizedTeachers/$(request.auth.uid)).data.active == true;
    }

    match /teacher-recordings/{yearLevelId}/{practiceId}/latest {
      allow read: if validYearLevel(yearLevelId) && validPractice(practiceId);
      allow create, update: if validYearLevel(yearLevelId)
        && validPractice(practiceId)
        && isAuthorisedTeacher()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if validYearLevel(yearLevelId) && validPractice(practiceId) && isAuthorisedTeacher();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
